# Identifiant public du Pixel Meta, visible dans le navigateur (c'est normal et sans risque). Il se trouve dans le Gestionnaire d'événements Meta.
NEXT_PUBLIC_META_PIXEL_ID=

# Token secret de l'API Conversions Meta. Ne jamais utiliser le préfixe NEXT_PUBLIC_ ; configurez-le dans les variables d'environnement Vercel.
META_CAPI_TOKEN=

# Uniquement pour les tests : récupérez ce code dans l'onglet « Test des événements » du Gestionnaire d'événements Meta. Retirez impérativement cette variable une fois les tests terminés, sinon les événements réels resteraient marqués comme des tests et ne compteraient pas dans les campagnes.
META_TEST_EVENT_CODE=
